+func TestSocksDomainAddressRoundTrip(t *testing.T) {
+	want := socksAddress{host: "example.com", port: 443}
+	encoded, err := marshalSocksAddress(want)
+	if err != nil {
+		t.Fatalf("marshal SOCKS5 address: %v", err)
+	}
+	got, err := readSocksAddress(bytes.NewReader(encoded))
+	if err != nil {
+		t.Fatalf("read SOCKS5 address: %v", err)
+	}
+	if got != want {
+		t.Fatalf("SOCKS5 address mismatch: got %#v, want %#v", got, want)
+	}
+}
