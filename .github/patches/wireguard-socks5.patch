index 0000000000000000000000000000000000000000..547bb4483651f3f68b0581c389f52e376c6fafc0
--- /dev/null
+++ b/Sources/WireGuardKit/WireGuardSocksAdapter.swift
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: MIT
+// Copyright © 2026 Proton AG. All Rights Reserved.
+
+#if os(macOS)
+import Foundation
+import Network
+
+#if SWIFT_PACKAGE
+import WireGuardKitGo
+import WireGuardKitSupport
+#endif
+
+public enum WireGuardSocksAdapterError: Error {
+    case invalidState
+    case invalidConfiguration(String)
+    case dnsResolution([DNSResolutionError])
+    case startWireGuardBackend(Int32)
+    case setWireGuardConfig(Int64)
+}
+
+public final class WireGuardSocksAdapter {
+    public typealias LogHandler = (WireGuardLogLevel, String) -> Void
+
+    private let logHandler: LogHandler
+    private let workQueue = DispatchQueue(label: "WireGuardSocksAdapterWorkQueue")
+    private let pathQueue = DispatchQueue(label: "WireGuardSocksAdapterPathQueue")
+    private var pathMonitor: NWPathMonitor?
+    private var handle: Int32?
+
+    public init(logHandler: @escaping LogHandler) {
+        self.logHandler = logHandler
+        setupLogHandler()
+    }
+
+    deinit {
+        pathMonitor?.cancel()
+        if let handle {
+            wgTurnOff(handle)
+        }
+        wgSetLogger(nil, nil)
+    }
+
+    public func start(
+        tunnelConfiguration: TunnelConfiguration,
+        listenAddress: String,
+        socketType: String,
+        completionHandler: @escaping (WireGuardSocksAdapterError?) -> Void
+    ) {
+        workQueue.async {
+            guard self.handle == nil else {
+                completionHandler(.invalidState)
+                return
+            }
+
+            do {
+                let settingsGenerator = try self.makeSettingsGenerator(tunnelConfiguration)
+                let (wgConfig, _) = settingsGenerator.uapiConfiguration()
+                let tunnelAddresses = tunnelConfiguration.interface.addresses
+                    .map(\.stringRepresentation)
+                    .joined(separator: ",")
+                guard !tunnelAddresses.isEmpty else {
+                    throw WireGuardSocksAdapterError.invalidConfiguration("missing tunnel address")
+                }
+                guard let dnsAddress = tunnelConfiguration.interface.dns.first(where: { server in
+                    guard case .classic = server.transport else { return false }
+                    return server.address is IPv4Address
+                })?.stringRepresentation else {
+                    throw WireGuardSocksAdapterError.invalidConfiguration("missing classic IPv4 DNS server")
+                }
+
+                let mtu = Int32(tunnelConfiguration.interface.mtu ?? 1280)
+                let handle = wgTurnOnSocks(
+                    wgConfig,
+                    listenAddress,
+                    tunnelAddresses,
+                    dnsAddress,
+                    mtu,
+                    socketType
+                )
+                guard handle >= 0 else {
+                    throw WireGuardSocksAdapterError.startWireGuardBackend(handle)
+                }
+
+                self.handle = handle
+                wgSetNetworkAvailable(handle, 1)
+                self.startPathMonitor()
+                completionHandler(nil)
+            } catch let error as WireGuardSocksAdapterError {
+                completionHandler(error)
+            } catch {
+                completionHandler(.invalidConfiguration(error.localizedDescription))
+            }
+        }
+    }
+
+    public func update(
+        tunnelConfiguration: TunnelConfiguration,
+        completionHandler: @escaping (WireGuardSocksAdapterError?) -> Void
+    ) {
+        workQueue.async {
+            guard let handle = self.handle else {
+                completionHandler(.invalidState)
+                return
+            }
+
+            do {
+                let settingsGenerator = try self.makeSettingsGenerator(tunnelConfiguration)
+                let (wgConfig, _) = settingsGenerator.uapiConfiguration()
+                let result = wgSetConfig(handle, wgConfig)
+                guard result == 0 else {
+                    completionHandler(.setWireGuardConfig(result))
+                    return
+                }
+                wgBumpSockets(handle)
+                completionHandler(nil)
+            } catch let error as WireGuardSocksAdapterError {
+                completionHandler(error)
+            } catch {
+                completionHandler(.invalidConfiguration(error.localizedDescription))
+            }
+        }
+    }
+
+    public func stop(completionHandler: @escaping (WireGuardSocksAdapterError?) -> Void) {
+        workQueue.async {
+            guard let handle = self.handle else {
+                completionHandler(.invalidState)
+                return
+            }
+
+            self.pathMonitor?.cancel()
+            self.pathMonitor = nil
+            self.handle = nil
+            wgTurnOff(handle)
+            completionHandler(nil)
+        }
+    }
+
+    private func makeSettingsGenerator(_ tunnelConfiguration: TunnelConfiguration) throws -> PacketTunnelSettingsGenerator {
+        let endpoints = tunnelConfiguration.peers.map(\.endpoint)
+        let results = DNSResolver.resolveSync(endpoints: endpoints)
+        let errors = results.compactMap { result -> DNSResolutionError? in
+            guard case let .failure(error)? = result else { return nil }
+            return error
+        }
+        guard errors.isEmpty else {
+            throw WireGuardSocksAdapterError.dnsResolution(errors)
+        }
+
+        let resolvedEndpoints = results.map { result -> Endpoint? in
+            guard case let .success(endpoint)? = result else { return nil }
+            return endpoint
+        }
+        return PacketTunnelSettingsGenerator(
+            tunnelConfiguration: tunnelConfiguration,
+            resolvedEndpoints: resolvedEndpoints
+        )
+    }
+
+    private func startPathMonitor() {
+        let monitor = NWPathMonitor()
+        monitor.pathUpdateHandler = { [weak self] path in
+            self?.workQueue.async {
+                guard let self, let handle = self.handle else { return }
+                if path.status == .satisfied {
+                    wgSetNetworkAvailable(handle, 1)
+                    wgBumpSockets(handle)
+                } else {
+                    wgSetNetworkAvailable(handle, 0)
+                }
+            }
+        }
+        pathMonitor = monitor
+        monitor.start(queue: pathQueue)
+    }
+
+    private func setupLogHandler() {
+        let context = Unmanaged.passUnretained(self).toOpaque()
+        wgSetLogger(context) { context, logLevel, message in
+            guard let context, let message else { return }
+            let adapter = Unmanaged<WireGuardSocksAdapter>.fromOpaque(context).takeUnretainedValue()
+            let level = WireGuardLogLevel(rawValue: logLevel) ?? .verbose
+            adapter.logHandler(level, String(cString: message).trimmingCharacters(in: .newlines))
+        }
+    }
+}
+#endif
