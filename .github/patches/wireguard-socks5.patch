+func TestSocksListenerRequiresLoopback(t *testing.T) {
+	server, err := startSocksServer("0.0.0.0:0", directSocksNetwork{}, nil)
+	if err == nil {
+		_ = server.Close()
+		t.Fatal("SOCKS5 server accepted a non-loopback listener")
+	}
+}
