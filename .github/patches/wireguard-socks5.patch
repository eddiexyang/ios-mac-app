+//export wgTurnOnSocks
+func wgTurnOnSocks(settings, listenAddress, tunnelAddresses, dnsAddress *C.char, mtu int32, socketType *C.char) int32 {
+	connLogger := conn.Logger{
+		Verbosef: CLogger(0).Printf,
+		Errorf:   CLogger(1).Printf,
+	}
+	logger := &device.Logger{connLogger}
+
+	var localAddresses []netip.Prefix
+	for _, value := range strings.Split(C.GoString(tunnelAddresses), ",") {
+		prefix, err := netip.ParsePrefix(strings.TrimSpace(value))
+		if err != nil {
+			logger.Errorf("Invalid userspace tunnel address %q: %v", value, err)
+			return -1
+		}
+		localAddresses = append(localAddresses, prefix)
+	}
+	dns, err := netip.ParseAddr(strings.TrimSpace(C.GoString(dnsAddress)))
+	if err != nil {
+		logger.Errorf("Invalid userspace DNS address: %v", err)
+		return -1
+	}
+	if mtu <= 0 {
+		mtu = 1280
+	}
+
+	tunDevice, err := createNetstackTUN(localAddresses, int(mtu))
+	if err != nil {
+		logger.Errorf("Unable to create userspace network stack: %v", err)
+		return -1
+	}
+
+	socketTypeGoString := C.GoString(socketType)
+	manager := device.NewWireGuardStateManager(logger, socketTypeGoString)
+	dev := device.NewDevice(tunDevice,
+		conn.CreateStdNetBind(socketTypeGoString,
+			&connLogger,
+			manager.SocketErrChan),
+		logger,
+		manager.HandshakeStateChan)
+
+	if err := dev.IpcSet(C.GoString(settings)); err != nil {
+		logger.Errorf("Unable to set IPC settings: %v", err)
+		dev.Close()
+		return -1
+	}
+	if err := dev.Up(); err != nil {
+		logger.Errorf("Unable to start userspace WireGuard device: %v", err)
+		dev.Close()
+		return -1
+	}
+
+	network := newNetstackNetwork(tunDevice, netip.AddrPortFrom(dns.Unmap(), 53))
+	socks, err := startSocksServer(C.GoString(listenAddress), network, logger)
+	if err != nil {
+		logger.Errorf("Unable to start SOCKS5 listener: %v", err)
+		dev.Close()
+		return -1
+	}
+	logger.Verbosef("SOCKS5 listener started on %s", socks.Addr())
+
+	var handleDescriptor int32
+	for handleDescriptor = 0; handleDescriptor < math.MaxInt32; handleDescriptor++ {
+		if _, exists := tunnelHandles[handleDescriptor]; !exists {
+			break
+		}
+	}
+	if handleDescriptor == math.MaxInt32 {
+		_ = socks.Close()
+		dev.Close()
+		return -1
+	}
+	manager.Start(dev)
+	tunnelHandles[handleDescriptor] = tunnelHandle{
+		WireGuardStateManager: manager,
+		Device:                dev,
+		Logger:                logger,
+		socks:                 socks,
+	}
+	return handleDescriptor
+}
+
